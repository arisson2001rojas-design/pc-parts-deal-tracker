{
  "manifest_version": 3,
  "name": "PriceBuddy Browser Companion",
  "version": "0.4.1",
  "description": "Verifies PC component prices from the retailer page already open in your browser.",
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "permissions": ["storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.walmart.com/*",
        "https://*.microcenter.com/*",
        "https://*.newegg.com/*",
        "https://*.bestbuy.com/*",
        "https://*.gamestop.com/*"
      ],
      "js": ["extractors.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "PriceBuddy Radar",
    "default_popup": "popup.html"
  }
}
